{
  "name": "blog-fut",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test && playwright test -c playwright.sem-banco.config.ts",
    "test:e2e:sem-banco": "playwright test -c playwright.sem-banco.config.ts",
    "test:e2e:db": "playwright test -c playwright.db.config.ts",
    "test:db": "supabase start && supabase db reset && vitest run --project db && playwright test -c playwright.db.config.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:importar": "tsx scripts/importar-conteudo.ts",
    "db:vault": "tsx scripts/configurar-vault.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
